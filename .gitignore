node_modules/
dist/
*.tsbuildinfo
# Two different cwd-relative locations: root `npm start` runs with cwd here,
# `npm run dev` runs with cwd inside apps/server (npm workspaces cd into the
# package before running its script).
/data/
apps/server/data/
# The Docker container's bind-mounted database (see docker-compose.yml) and the
# snapshots scripts/deploy.sh takes of it before every restart.
/DATA/
/backups/
# WAL mode (apps/server/src/db.ts) always writes these two alongside the
# database file itself.
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
# Host specific deployment settings, seeded from .env.example on first deploy.
# Untracked on purpose: this is what lets an update pull a new compose file
# without resetting the port or the uid of this particular machine.
.env
docker-compose.override.yml
.DS_Store
