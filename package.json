{
  "name": "vibe-realms",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync:engine": "node scripts/sync-engine.mjs",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "sync": "node scripts/sync-engine.mjs && node scripts/extract-cards.mjs && node scripts/sync-i18n.mjs && node scripts/sync-colours.mjs && node scripts/compute-harm.mjs && node scripts/gen-upstream-tests.mjs",
    "e2e": "node scripts/e2e-smoke.mjs",
    "start": "node apps/server/src/index.ts"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
