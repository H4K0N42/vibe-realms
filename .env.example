# Local deployment settings. Copy to .env (scripts/deploy.sh does that for you
# on first run) and edit. .env is gitignored, so an update never overwrites it:
# that is the whole point of this file existing rather than putting the values
# straight into docker-compose.yml, which git does track and would reset.
#
# Compose reads .env automatically for the ${...} substitutions in
# docker-compose.yml. The container itself only ever sees PORT, FR_DATA_DIR and
# FR_STATIC_DIR, which are set in the image and in the compose file.

# Port published on the host. The server always listens on 3000 inside the
# container; this is only the outside half of the mapping.
FR_HOST_PORT=3000

# Where the SQLite database lives on the host, relative to this file or
# absolute. Backups from scripts/deploy.sh are taken from here.
FR_DATA=./DATA

# Memory ceiling for the container. The server keeps room state in memory and
# not much else, so this is a backstop against a flood, not a working size.
FR_MEM_LIMIT=512m

# The uid:gid the container runs as. It has to be able to write FR_DATA, so
# this is normally your own `id -u`/`id -g`. 1000:1000 is the first regular
# user on most single user Linux hosts and is also the built in `node` user of
# the base image, which is why it is the default.
FR_UID=1000
FR_GID=1000
