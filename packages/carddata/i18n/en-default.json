":"Spyglass","bonus":[{"kind":"text","value":"Look at another player’s hand."}],"penalty":[{"kind":"text","value":"(*This item’s base value is -10 in 2-player game)"}]},"CH25":{"name":"Sarcophagus","bonus":[{"kind":"text","value":"Take the top card from the deck and place it directly in the discard area, then end your turn. "},{"kind":"break"},{"kind":"text","value":"(The makeup of your hand will not change this turn.)"}]},"CH26":{"name":"Blindfold","bonus":[{"kind":"text","value":"Reverse normal turn order: discard a card first, then draw a card from the deck."}]},"CH27":{"name":"Book of Prophecy","bonus":[{"kind":"text","value":"Look at the bottom seven cards of the deck, then replace them there."}]},"CH28":{"name":"Crystal Ball","bonus":[{"kind":"text","value":"Name a suit. All other players must reveal all cards they possess of that suit."}]},"CH29":{"name":"Market Wagon","bonus":[{"kind":"text","value":"Reveal a card from your hand. Any other player may reveal up to 3 cards to offer in exchange. "},{"kind":"break"},{"kind":"text","value":"You may choose to trade your card for one of them; if no offer is acceptable, keep your card or discard it and draw from the deck."}]},"CH30":{"name":"Backpack","bonus":[{"kind":"text","value":"Draw three "},{"kind":"ref","value":"Cursed Items","suit":"cursed-item"},{"kind":"text","value":" and set them aside face up. "},{"kind":"break"},{"kind":"text","value":"The next three times you would draw a new "},{"kind":"ref","value":"Cursed Item","suit":"cursed-item"},{"kind":"text","value":" from the deck, you must take one of these cards instead."}]},"CH31":{"name":"Shovel","bonus":[{"kind":"text","value":"Put a card from the discard area on the bottom of the deck."}]},"CH32":{"name":"Sealed Vault","bonus":[{"kind":"text","value":"Cover two cards in the discard area with this card. They still count towards the end of the game and give bonuses to "},{"kind":"ref","value":"Undead","suit":"undead"},{"kind":"text","value":", but no on